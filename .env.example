[TEMPLATE]
# Salin file ini menjadi .env.local lalu sesuaikan.
#   cp .env.example .env.local

# ============ DATABASE (Supabase PostgreSQL — WAJIB pooler) ============
# Project Settings → Database → Connection string → Pooler (port 6543).
# JANGAN pakai port 5432 langsung — prepared statement akan error intermiten.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ============ SUPABASE (opsional, untuk Auth/Storage/Realtime native) ============
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=          # server-only, JANGAN pernah expose

# ============ ADMIN AWAL (untuk scripts/setup-db.mjs) ============
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-kuat
ADMIN_NAME=Admin Toko

# ============ SECURITY ============
# WAJIB diganti. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ============ SESSION CUSTOMER ============
CUSTOMER_SESSION_DAYS=14

# ============ WHATSAPP (opsional) ============
# Development pakai mock. Saat produksi: fonnte / wablas / dll.
WHATSAPP_PROVIDER=mock
# WHATSAPP_TOKEN=

# ============ APP ============
NEXT_PUBLIC_APP_URL=http://localhost:3000
