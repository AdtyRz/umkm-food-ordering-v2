# Salin file ini menjadi .env.local lalu sesuaikan.
#   cp .env.example .env.local

# ============ DATABASE (MySQL XAMPP - development) ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=umkm_food_ordering
# Alternatif: DATABASE_URL=mysql://root:@127.0.0.1:3306/umkm_food_ordering

# ============ SUPABASE (production) ============
# Isi SEMUA variabel di bawah + komentar blok MySQL di atas untuk pindah
# ke Supabase. Panduan lengkap: SUPABASE_MIGRATION.md
# Mode koneksi (wajib diisi saat migrasi):
#   NEXT_PUBLIC_DATA_MODE=supabase
# Supabase project:
#   NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=          # server-only, JANGAN pernah expose
# Pooler connection string (Region pooled, port 6543) untuk Drizzle:
#   DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ============ ADMIN AWAL (untuk scripts/setup-db.mjs) ============
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-kuat
ADMIN_NAME=Admin Toko

# ============ SECURITY ============
# WAJIB diganti. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ============ SESSION CUSTOMER ============
CUSTOMER_SESSION_DAYS=14

# ============ WHATSAPP (opsional) ============
# Development pakai mock. Saat produksi: fonnte / wablas / dll.
WHATSAPP_PROVIDER=mock
# WHATSAPP_TOKEN=

# ============ APP ============
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============ SUPABASE (untuk migrasi ke production nanti) ============
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
